# Токен от @BotFather. Настоящий — только на сервере в /etc/pngify-bot.env (права 600).
BOT_TOKEN=
# Telegram id владельца: без лимита страниц, команда /stats.
OWNER_ID=
# Рабочая папка для временных файлов (каждая задача — своя подпапка, удаляется сразу после отправки).
WORK_DIR=/var/lib/pngify/jobs
# Свой сервер Bot API (контейнер aiogram/telegram-bot-api, --local) — файлы до 2000 МБ.
# Пусто — облачный api.telegram.org, тогда файлы только до 20 МБ.
BOT_API_ROOT=http://127.0.0.1:8083
# Где свой сервер хранит файлы: путь внутри контейнера и тот же каталог на сервере.
BOTAPI_DIR_CONTAINER=/var/lib/telegram-bot-api
BOTAPI_DIR_HOST=/var/lib/pngify/botapi
# Лимиты размера: всем и владельцу (МБ).
MAX_FILE_MB=200
OWNER_MAX_FILE_MB=2000
# Лимиты страниц.
MAX_PAGES=60
OWNER_MAX_PAGES=500
# Сколько секунд даём LibreOffice на один файл.
CONVERT_TIMEOUT_SEC=300
# 1 — конвертировать в песочнице без сети (bubblewrap). 0 — только для локальной разработки.
SANDBOX=1
