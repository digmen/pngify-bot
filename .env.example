# Токен от @BotFather. Настоящий — только на сервере в /etc/pngify-bot.env (права 600).
BOT_TOKEN=
# Telegram id владельца: без лимита страниц, команда /stats.
OWNER_ID=
# Рабочая папка для временных файлов (каждая задача — своя подпапка, удаляется сразу после отправки).
WORK_DIR=/var/lib/pngify/jobs
# Лимиты для всех, кроме владельца.
MAX_FILE_MB=20
MAX_PAGES=60
OWNER_MAX_PAGES=500
# Сколько секунд даём LibreOffice на один файл.
CONVERT_TIMEOUT_SEC=120
# 1 — конвертировать в песочнице без сети (bubblewrap). 0 — только для локальной разработки.
SANDBOX=1
