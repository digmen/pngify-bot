{
  "name": "pngify-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот @PngifyBot: презентации, документы, таблицы и PDF в PNG-картинки",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.30.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
